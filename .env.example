# Names only. Real values live in the secret store, never in the repo.
# Local dev: copy to .env and use the docker-compose Postgres below.

NODE_ENV=development
APP_ENV=local                 # local | staging | production
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://creative_hub:creative_hub@localhost:5433/creative_hub

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated domains allowed to register, e.g. vilore.com,bloomteq.com. Empty = anyone.
AUTH_ALLOWED_EMAIL_DOMAINS=
# SSO (later)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Connectors (empty = in-memory fake)
# Master Board the worker writes to (VH_Sandbox sample: 18440211929). Never deletes there.
MONDAY_BOARD_ID=
# People columns notify real people; leave off while testing.
MONDAY_ASSIGN_PEOPLE=
MONDAY_API_TOKEN=
# Bearer secret for /api/jobs/run (Vercel Cron and the GitHub Actions schedule).
CRON_SECRET=
# Service-account JSON, stored locally or in the deployment secret store.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Root folder or Shared Drive ID. Uploads need a Shared Drive (see docs/GOOGLE_DRIVE_TEST.md).
GOOGLE_DRIVE_ROOT_FOLDER_ID=0AJ_eJkQ6C5UJUk9PVA
SLACK_BOT_TOKEN=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
