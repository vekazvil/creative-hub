# Names only. Real values live in the secret store, never in the repo.
# Local dev: copy to .env and use the docker-compose Postgres below.

NODE_ENV=development
APP_ENV=local                 # local | staging | production
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://creative_hub:creative_hub@localhost:5433/creative_hub

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated domains allowed to register, e.g. vilore.com,bloomteq.com. Empty = anyone.
AUTH_ALLOWED_EMAIL_DOMAINS=
# SSO (later)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Connectors (empty = in-memory fake)
MONDAY_API_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
SLACK_BOT_TOKEN=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
